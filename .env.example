# Database locale (Docker) — credenziali solo per sviluppo
DB_PORT=3308
DB_NAME=golduck_marketing
DB_USER=gm
DB_PASSWORD=cambiami
DB_ROOT_PASSWORD=cambiami
DATABASE_URL=mysql://gm:cambiami@127.0.0.1:3308/golduck_marketing

# Auth.js (login): genera con `openssl rand -base64 33`
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Solo sviluppo locale: utente di prova creato da `npm run db:seed` (es. admin / admin)
DEV_DEMO_EMAIL=admin
DEV_DEMO_PASSWORD=admin

# Indirizzo pubblico dell'app (per i collegamenti OAuth). Online: https://2target.golduck.it
APP_URL=http://localhost:3070

# Collegamenti alle piattaforme: guida in docs/COLLEGAMENTI-API.md
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PAGESPEED_KEY=

# Sincronizzazione notturna (Plesk → Operazioni pianificate)
CRON_SECRET=
